{
  "name": "dsh-custom-json-mcp",
  "version": "1.0.1",
  "description": "连接器：在左侧栏管理 MCP 服务器，粘贴标准 MCP JSON 即可随时添加、停用、重连或删除，并为 HTTP 服务器完成 OAuth 授权。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.png",
  "license": "MIT",
  "author": "ApakohZzz",
  "homepage": "https://github.com/ApakohZzz/dsh-custom-json-mcp#readme",
  "repository": { "type": "git", "url": "git+https://github.com/ApakohZzz/dsh-custom-json-mcp.git" },
  "bugs": { "url": "https://github.com/ApakohZzz/dsh-custom-json-mcp/issues" },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "MCP", "mcpServers", "connector", "连接器", "OAuth", "Model Context Protocol"],
  "engines": { "node": ">=22.20.0", "dsh": ">=0.2.1-rc.2 <0.2.2" },
  "peerDependencies": { "@deepseek-ai/dsh": "0.2.1-rc.2" },
  "dependencies": { "@deepseek-ai/schemastery": "3.18.5" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-api-remotes"] }
  },
  "files": ["lib", "locale", "icon.png", "cordis.patch.yml", "README.md", "README.en.md", "upstream.json", "upstream", "LICENSE"]
}
